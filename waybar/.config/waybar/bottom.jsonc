// Verified against: waybar(5), waybar-wlr-taskbar(5), waybar-sway-scratchpad(5)
// Reviewed: 2026-08-23
{
  "name": "bottom",
  "layer": "top",
  "position": "bottom",
  "height": 64,
  "spacing": 0,
  "margin-bottom": 4,
  // Reduce la superficie wlr-layer-shell al ancho de la píldora.
  // Con layer:top el bar captura clicks en TODA su superficie aunque sea
  // transparente. Estos márgenes reducen la superficie real (no solo visual)
  // para que los clicks en los bordes pasen a las ventanas.
  // Ajustar si el taskbar se desborda con muchas ventanas abiertas.
  "width": 384,
  "margin-left": 0,
  "margin-right": 0,
  "exclusive": false,
  "modules-left": [],
  "modules-center": [
    "group/launchers",
    "group/windows"
  ],
  "modules-right": [],
  "group/launchers": {
    "orientation": "horizontal",
    "modules": [
      "custom/terminal",
      "custom/browser",
      "custom/files"
      // "custom/editor"
    ]
  },
  "group/windows": {
    "orientation": "horizontal",
    "modules": [
      "wlr/taskbar",
      "sway/scratchpad"
    ]
  },
  "custom/terminal": {
    "format": "",
    "on-click": "ghostty",
    "tooltip": true,
    "tooltip-format": "Terminal"
  },
  "custom/browser": {
    "format": "",
    "on-click": "swayfx-browser",
    "tooltip": true,
    "tooltip-format": "Brave Origin"
  },
  "custom/files": {
    "format": "",
    "on-click": "nautilus",
    "tooltip": true,
    "tooltip-format": "Archivos"
  },
  /*   "custom/editor": {
    "format": "",
    "on-click": "gnome-text-editor",
    "tooltip": true,
    "tooltip-format": "Editor"
  }, */
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 28,
    "all-outputs": false,
    "active-first": true,
    "icon-theme": [
      "Papirus-Dark",
      "Papirus"
    ],
    "tooltip-format": "{name}: {title}",
    "on-click": "minimize-raise",
    "on-click-right": "maximize",
    "on-click-middle": "close"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}",
    "on-click": "swaymsg scratchpad show"
  }
}
