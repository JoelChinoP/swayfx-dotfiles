#!/usr/bin/env bash
# Launch the project browser with Wayland and VA-API focused flags.
#
# Verified against: https://brave.com/origin/linux/ and Chromium VA-API docs
# Reviewed: 2026-07-07

set -euo pipefail
IFS=$'\n\t'

DEV_PROFILE="${HOME}/.config/BraveSoftware/Brave-Origin-Dev"

if [[ "${1:-}" == "--dev" ]]; then
    shift
    DEV_FLAGS=(
        --disable-web-security
        --user-data-dir="$DEV_PROFILE"
        --password-store=basic
        --ozone-platform-hint=auto
        --enable-wayland-ime
        --force-dark-mode
        --ignore-gpu-blocklist
        --disable-vulkan
        --use-angle=gl
        --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks,WaylandWindowDecorations,WebUIDarkMode
    )
    pkill -f "user-data-dir=$DEV_PROFILE" 2>/dev/null || true
    sleep 0.5
    rm -f "$DEV_PROFILE"/Singleton*
    if command -v brave-origin >/dev/null 2>&1; then
        exec brave-origin "${DEV_FLAGS[@]}" "$@"
    elif [[ -x /opt/brave-origin-bin/brave-origin ]]; then
        exec /opt/brave-origin-bin/brave-origin "${DEV_FLAGS[@]}" "$@"
    fi
    printf 'swayfx-browser: no Brave Origin browser found. Install brave-origin-bin.\n' >&2
    exit 127
fi

FLAGS=(
    --ozone-platform-hint=auto
    --enable-wayland-ime
    --password-store=basic
    --force-dark-mode
    --ignore-gpu-blocklist
    --disable-vulkan
    --use-angle=gl
    --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks,WaylandWindowDecorations,WebUIDarkMode
)

launch_origin_release() {
    export CHROME_USER_DATA_DIR="${CHROME_USER_DATA_DIR:-$HOME/.config/BraveSoftware/Brave-Origin}"
    if command -v brave-origin >/dev/null 2>&1; then
        exec brave-origin "${FLAGS[@]}" "$@"
    elif [[ -x /opt/brave-origin-bin/brave-origin ]]; then
        exec /opt/brave-origin-bin/brave-origin "${FLAGS[@]}" "$@"
    fi
}

launch_origin_nightly() {
    export CHROME_USER_DATA_DIR="${CHROME_USER_DATA_DIR:-$HOME/.config/BraveSoftware/Brave-Origin-Nightly}"
    if [[ -x /opt/brave.com/brave-origin-nightly/brave-origin ]]; then
        exec /opt/brave.com/brave-origin-nightly/brave-origin "${FLAGS[@]}" "$@"
    fi
    exec brave-origin-nightly "${FLAGS[@]}" "$@"
}

if command -v brave-origin >/dev/null 2>&1 || [[ -x /opt/brave-origin-bin/brave-origin ]]; then
    launch_origin_release "$@"
elif command -v brave-origin-nightly >/dev/null 2>&1 || [[ -x /opt/brave.com/brave-origin-nightly/brave-origin ]]; then
    launch_origin_nightly "$@"
elif command -v brave >/dev/null 2>&1; then
    exec brave "${FLAGS[@]}" "$@"
fi

printf 'swayfx-browser: no Brave Origin browser found. Install brave-origin-bin.\n' >&2
exit 127
